NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used in invite / password-reset email links (no trailing slash).
# Production example: https://app.datafreaks.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — required for invite and password-reset emails when creating users.
RESEND_API_KEY=your-resend-api-key
# Must use a domain verified in Resend.
EMAIL_FROM=DealerACQ <onboarding@yourdomain.com>

# Soft-launch invite checklist:
# 1) Set NEXT_PUBLIC_SITE_URL, RESEND_API_KEY, EMAIL_FROM on Vercel (prod).
# 2) Supabase Auth → URL config: Site URL matches production; Redirect URLs include
#    {SITE_URL}/auth/callback
# 3) Smoke test: Admin → Users → + Add User → confirm email → set password → land in /app as active.
# 4) If the link expires, open the user detail page and use Resend invite.

